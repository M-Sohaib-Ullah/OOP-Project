rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // User rules
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn(); // We want to show leaderboards, but limit returned fields in a real scenario
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().uid == userId &&
        incoming().keys().hasAll(['uid', 'email', 'xp', 'streak']) &&
        incoming().xp is number &&
        incoming().streak is number;
      allow update: if isSignedIn() && request.auth.uid == userId &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'streak', 'lastStudyDate']);
    }

    // ExamResults rules
    match /examResults/{resultId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'subject', 'score', 'totalScore', 'feedback', 'dateTaken']) &&
        incoming().score is number &&
        incoming().totalScore is number;
      allow update, delete: if false; // Exam results are immutable
    }

    // Flashcards rules
    match /flashcards/{flashcardId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'topic', 'question', 'answer', 'createdAt']) &&
        incoming().topic is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'question', 'answer']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

  }
}
